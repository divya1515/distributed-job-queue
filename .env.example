# Copy to .env and replace the dummy values:  cp .env.example .env
# The localhost URLs are for running the services on your machine;
# docker compose overrides them with the container hostnames.

# --- PostgreSQL container (read by docker-compose.yaml) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=postgres
POSTGRES_PORT=5433

# --- Required ---
DATABASE_URL=postgresql+asyncpg://postgres:change-me@localhost:5433/postgres
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
API_SERVICE_URL=http://localhost:8000
SHORTNER_SERVICE=http://localhost:8001
GMAIL_ADDRESS=your.address@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# --- Optional (defaults shown) ---
WORKER_SERVICE_PREFETCH_COUNT=5
NOTIFICATION_SERVICE_PREFETCH_COUNT=7
MAX_RETRIES=3
DATACENTER_ID=0
MACHINE_ID=0
JOB_FILES_DIR=./job_files

# --- Auth module ---
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE=1
